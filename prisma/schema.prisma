// RentHive data model.
// Uses PostgreSQL for both local dev and production (Vercel-ready).
// Set DATABASE_URL in .env to your Postgres connection string (e.g. a free
// Neon or Vercel Postgres database). See INTEGRATIONS.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LANDLORD
  TENANT
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  ACTIVE
  PENDING
  ENDED
}

enum InvoiceStatus {
  PAID
  DUE
  OVERDUE
  PARTIAL
  VOID
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RENTED
}

enum ApplicationStage {
  LEAD
  APPLICATION
  SCREENING
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  APPROVED
  DECLINED
}

enum InspectionType {
  MOVE_IN
  MOVE_OUT
  ROUTINE
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum ReminderType {
  LEASE
  RENT
  MAINTENANCE
  INSPECTION
  CUSTOM
}

enum InvoiceType {
  RENT
  DEPOSIT
  LATE_FEE
  UTILITY
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  phone              String?
  additionalPhone    String?
  company            String?
  displayAsCompany   Boolean  @default(false)
  middleName         String?
  dob                DateTime?
  additionalEmail    String?
  forwardingAddress  String?
  archived           Boolean  @default(false)
  managedById        String?
  emergencyContact   String?
  notes              String?
  role               Role     @default(TENANT)
  notifyOverdue      Boolean  @default(true)
  notifyApplications Boolean  @default(true)
  notifyMaintenance  Boolean  @default(true)
  notifyInspections  Boolean  @default(true)
  dashboardWidgets   String[] @default(["calendar", "recentlyViewed", "leaseFunnel", "accounting", "applications", "onlinePayments", "maintenance", "overdueInvoices"])
  createdAt          DateTime @default(now())

  // A landlord owns properties; a tenant holds leases.
  properties Property[] @relation("LandlordProperties")
  leases     Lease[]    @relation("TenantLeases")
  requests   MaintenanceRequest[] @relation("TenantRequests")
}

model Property {
  id                  String   @id @default(cuid())
  name                String
  address             String
  city                String
  state               String
  zip                 String
  country             String   @default("United States")
  type                String   @default("Apartment")
  unitType            String   @default("SINGLE") // SINGLE | MULTI
  yearBuilt           Int?
  mls                 String?
  isMobileHome        Boolean  @default(false)
  isAffordableHousing Boolean  @default(false)
  parking             String?
  laundry             String?
  airConditioning     String?
  features            String[] @default([])
  amenities           String[] @default([])
  imageUrl            String?
  landlordId          String
  createdAt           DateTime @default(now())

  landlord    User         @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  units       Unit[]
  expenses    Expense[]
  incomes     Income[]
  inspections Inspection[]
  documents   Document[]
}

model Income {
  id          String   @id @default(cuid())
  landlordId  String
  scope       String   @default("PROPERTY") // PROPERTY | GENERAL
  category    String   @default("Rent")
  subcategory String?
  propertyId  String?
  payer       String?
  amount      Float
  dueDate     DateTime @default(now())
  status      String   @default("DUE") // DUE | PAID
  details     String?
  createdAt   DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model Unit {
  id         String     @id @default(cuid())
  label      String
  beds       Int        @default(1)
  baths      Float      @default(1)
  sqft       Int?
  rent       Float      @default(0)
  deposit    Float      @default(0)
  status     UnitStatus @default(VACANT)
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   Lease[]
  requests MaintenanceRequest[]
  listings Listing[]
}

model Lease {
  id            String      @id @default(cuid())
  unitId        String
  tenantId      String
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float
  depositAmount Float       @default(0)
  rentDueDay    Int         @default(1)
  status        LeaseStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  unit      Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant    User               @relation("TenantLeases", fields: [tenantId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  recurring RecurringInvoice[]
}

model RecurringInvoice {
  id        String    @id @default(cuid())
  leaseId   String
  category  String    @default("Rent")
  amount    Float
  frequency String    @default("MONTHLY")
  startDate DateTime  @default(now())
  endDate   DateTime?
  nextDate  DateTime
  status    String    @default("ACTIVE") // ACTIVE | ENDED
  details   String?
  createdAt DateTime  @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String        @id @default(cuid())
  leaseId   String
  type      InvoiceType   @default(RENT)
  amount    Float
  dueDate   DateTime
  status    InvoiceStatus @default(DUE)
  memo      String?
  createdAt DateTime      @default(now())

  lease    Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   @default("Card")
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model MaintenanceRequest {
  id          String              @id @default(cuid())
  unitId      String
  tenantId    String
  title       String
  description String
  category    String              @default("General")
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(OPEN)
  recurring   Boolean             @default(false)
  assigneeId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant   User        @relation("TenantRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  assignee ServicePro? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Expense {
  id         String   @id @default(cuid())
  propertyId String?
  category   String   @default("Repairs")
  vendor     String?
  amount     Float
  date       DateTime @default(now())
  status     String   @default("PAID")
  memo       String?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model Listing {
  id          String        @id @default(cuid())
  unitId      String
  rent        Float
  status      ListingStatus @default(PUBLISHED)
  headline    String?
  description String?
  // Leasing details
  securityDeposit    Float?
  amountRefundable   Float?
  dateAvailable      DateTime?
  minLease           Int?
  maxLease           Int?
  monthToMonth       Boolean  @default(false)
  leasingDetails     String?
  petsAllowed        Boolean  @default(false)
  petsPolicy         String?
  // Property info
  parking         String?
  laundry         String?
  airConditioning String?
  amenities       String[] @default([])
  features        String[] @default([])
  coverPhotoUrl   String?
  gallery         String[] @default([])
  videoUrl        String?
  // Application settings
  screeningTier      String  @default("Full check")
  incomeVerification Boolean @default(true)
  onlineApplications Boolean @default(true)
  // Marketing
  contactName  String?
  contactPhone String?
  contactEmail String?
  displayPhone Boolean  @default(true)
  ribbonType   String   @default("None")
  ribbonTitle  String?
  ribbonColor  String?
  syndication  String[] @default([])
  createdAt    DateTime @default(now())

  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id          String            @id @default(cuid())
  listingId   String?
  name        String
  email       String?
  phone       String?
  stage       ApplicationStage  @default(LEAD)
  status      ApplicationStatus @default(NEW)
  creditScore Int?
  income      Float?
  notes       String?
  createdAt   DateTime          @default(now())

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

model ServicePro {
  id               String   @id @default(cuid())
  name             String
  firstName        String?
  lastName         String?
  middleName       String?
  company          String?
  displayAsCompany Boolean  @default(false)
  website          String?
  category         String   @default("General")
  subcategory      String?
  phone            String?
  additionalPhone  String?
  fax              String?
  email            String?
  additionalEmail  String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  notes            String?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())

  requests MaintenanceRequest[]
}

model Inspection {
  id           String           @id @default(cuid())
  propertyId   String
  unitLabel    String?
  type         InspectionType   @default(ROUTINE)
  status       InspectionStatus @default(SCHEDULED)
  inspector    String?
  scheduledFor DateTime
  notes        String?
  createdAt    DateTime         @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("pdf")
  sizeKb     Float    @default(0)
  category   String   @default("Lease")
  propertyId String?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model Reminder {
  id         String       @id @default(cuid())
  title      String
  type       ReminderType @default(CUSTOM)
  date       DateTime
  propertyId String?
  createdAt  DateTime     @default(now())
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

model Insurance {
  id             String   @id @default(cuid())
  tenantId       String
  leaseId        String?
  company        String?
  website        String?
  policyNumber   String
  effectiveDate  DateTime
  expirationDate DateTime
  details        String?
  createdAt      DateTime @default(now())
}

model BankAccount {
  id         String   @id @default(cuid())
  landlordId String
  bankName   String
  nickname   String?
  mask       String
  createdAt  DateTime @default(now())

  reconciliations Reconciliation[]
}

model Reconciliation {
  id            String   @id @default(cuid())
  bankAccountId String
  startDate     DateTime
  autoRefresh   Boolean  @default(false)
  createdAt     DateTime @default(now())

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines       BankStatementLine[]
}

model BankStatementLine {
  id               String   @id @default(cuid())
  reconciliationId String
  date             DateTime
  description      String
  amount           Float // positive = deposit, negative = withdrawal
  matchStatus      String   @default("TO_REVIEW") // TO_REVIEW | MATCHED | IGNORED
  matchedRef       String?
  note             String?
  createdAt        DateTime @default(now())

  reconciliation Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
}
